{
  "name": "flyshare",
  "version": "0.1.2",
  "description": "Fast cross-platform file transfer over local Wi-Fi (Windows / macOS / Linux)",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "flyshare": "src/main.js"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "test": "node test/pairing.js && node test/protocol.js && node test/e2e.js",
    "test:e2e": "node test/e2e.js",
    "test:protocol": "node test/protocol.js",
    "test:pairing": "node test/pairing.js",
    "build": "node scripts/build.js",
    "screenshots": "node scripts/screenshots.js http://127.0.0.1:45890/"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
