<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Without this the OS filters multicast and broadcast datagrams and
         discovery silently finds nothing: sockets bind, packets go out, and
         none ever come back. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- A transfer must survive the person switching apps, which means a
         foreground service, which means a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wi-Fi power saving parks the radio between packets and costs far more
         throughput than the lock costs battery over a few seconds. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Replaces the old location requirement for Wi-Fi work on API 33+. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33"
        xmlns:tools="http://schemas.android.com/tools" />

    <application
        android:name="com.lunov.flyshare.android.FlyShareApp"
        android:label="FlyShare"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlyShare">
        <!-- Fully qualified rather than a leading dot. A dot resolves against
             the module's namespace, so the two have to agree; spelling the
             class out means a rename cannot quietly produce a manifest that
             builds and then dies on launch with ClassNotFoundException. -->
        <activity
            android:name="com.lunov.flyshare.android.MainActivity"
            android:exported="true"
            android:label="FlyShare"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Sharing into the app from anywhere: a photo from the gallery,
                 a file from a manager. singleTop above means a second share
                 reaches the running activity through onNewIntent rather than
                 stacking another copy of the device list on top of itself. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name="com.lunov.flyshare.android.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
