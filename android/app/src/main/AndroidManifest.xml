<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Without this the OS filters multicast and broadcast datagrams and
         discovery silently finds nothing: sockets bind, packets go out, and
         none ever come back. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Replaces the old location requirement for Wi-Fi work on API 33+. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33"
        xmlns:tools="http://schemas.android.com/tools" />

    <application
        android:label="FlyShare"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlyShare">
        <!-- Fully qualified on purpose: a leading dot is resolved against the
             module's namespace (com.lunov.flyshare), while the sources live in
             com.lunov.flyshare.android. ".MainActivity" builds fine and then
             dies on launch with ClassNotFoundException. -->
        <activity
            android:name="com.lunov.flyshare.android.MainActivity"
            android:exported="true"
            android:label="FlyShare"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Sharing into the app from anywhere: a photo from the gallery,
                 a file from a manager. singleTop above means a second share
                 reaches the running activity through onNewIntent rather than
                 stacking another copy of the device list on top of itself. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
